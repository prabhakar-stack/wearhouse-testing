{
  "manifest_version": 3,
  "name": "Amazon SmartHub Session Sync",
  "version": "1.0",
  "description": "Automatically captures and syncs logged-in Amazon SmartHub sessions to the warehouse backend.",
  "permissions": [
    "cookies",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://smarthub.amazon.in/*",
    "https://*.amazon.in/*",
    "https://wearhouse-testing.onrender.com/*",
    "https://*.onrender.com/*",
    "https://wearhouse-testing-uc5i.vercel.app/*",
    "https://*.vercel.app/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://wearhouse-testing.onrender.com/*",
        "https://*.onrender.com/*",
        "https://wearhouse-testing-uc5i.vercel.app/*",
        "https://*.vercel.app/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
